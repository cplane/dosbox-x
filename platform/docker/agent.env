# DOSBox-X RPC debugger agent (src/agent, docs/rpc-agent-usage.md), used by
# the dosbox-x-debug image: JSON-RPC over a Unix socket in /dev/shm, which
# the stream sidecar shares and bridges to the browser (stream/agent.go).
transport=unix_socket
endpoint=/dev/shm/dosbox-agent.sock
dosbox_executable=/usr/bin/dosbox-x
dosbox_workdir=/data/c
profile=production
request_timeout_ms=10000
max_message_bytes=1048576
max_memory_read_bytes=65536
max_trace_events=20000
