{"v":1,"src":"MOV     AH, 05h          ; BIOS: put a key into the keyboard buffer\nMOV     CX, 2348h        ; CH = scan code, CL = \"H\"\nINT     16h\nMOV     AH, 05h\nMOV     CX, 1769h        ; \"i\"\nINT     16h\nMOV     AH, 05h\nMOV     CX, 1C0Dh        ; Enter\nINT     16h\nMOV     AH, 3Fh          ; DOS: read from handle 0\nXOR     BX, BX           ; BX = 0: standard input\nMOV     CX, 20           ; room for 20 bytes\nMOV     DX, OFFSET LINE1\nINT     21h\nCALL    CHECK\nMOV     SI, AX           ; SI = bytes read, CR and LF included\nMOV     DX, OFFSET M1\nMOV     AH, 09h          ; DOS: print the string at DS:DX\nINT     21h\nMOV     AX, SI\nCALL    PDEC\nMOV     DX, OFFSET M2\nMOV     AH, 09h          ; DOS: print the string at DS:DX\nINT     21h\nMOV     CX, SI\nMOV     DX, OFFSET LINE1\nCALL    OUT1             ; the line, with its CR LF\n\nLINE1   DB      20 DUP (?)\nM1      DB      \"got $\"\nM2      DB      \" bytes: $\"\nCHECK   PROC    NEAR     ; CF = 1: print the error code in AL and exit\nJNC     CHECK1\nPUSH    AX\nMOV     DX, OFFSET FAILMSG\nMOV     AH, 09h\nINT     21h\nPOP     AX\nCALL    PHEXB\nMOV     AX, 4C01h        ; exit with code 1\nINT     21h\nCHECK1:\nRET\nCHECK   ENDP\nFAILMSG DB      \"failed: error $\"\nPHEXB   PROC    NEAR     ; print AL as two hex digits\nPUSH    CX\nPUSH    DX\nMOV     DH, AL           ; keep the byte\nMOV     CL, 4\nSHR     AL, CL           ; the high digit first\nMOV     CX, 2\nPHEXB1:\nAND     AL, 0Fh\nADD     AL, \"0\"\nCMP     AL, \"9\"\nJBE     PHEXB2\nADD     AL, 7            ; 10..15 -> \"A\"..\"F\"\nPHEXB2:\nMOV     DL, AL\nMOV     AH, 02h          ; DOS: print DL\nINT     21h\nMOV     AL, DH           ; then the low digit\nLOOP    PHEXB1\nPOP     DX\nPOP     CX\nRET\nPHEXB   ENDP\nPDEC    PROC    NEAR     ; print AX in decimal\nPUSH    BX\nPUSH    CX\nPUSH    DX\nMOV     BX, 10\nXOR     CX, CX           ; CX = digits pushed\nPDEC1:\nXOR     DX, DX\nDIV     BX               ; AX = AX / 10, DX = the last digit\nPUSH    DX\nINC     CX\nOR      AX, AX\nJNZ     PDEC1\nPDEC2:\nPOP     DX               ; the digits come back first to last\nADD     DL, \"0\"\nMOV     AH, 02h\nINT     21h\nLOOP    PDEC2\nPOP     DX\nPOP     CX\nPOP     BX\nRET\nPDEC    ENDP\nOUT1    PROC    NEAR     ; write CX bytes at DS:DX to handle 1\nPUSH    BX\nMOV     BX, 1            ; standard output\nMOV     AH, 40h\nINT     21h\nPOP     BX\nRET\nOUT1    ENDP","seg":2070,"dataAt":346,"vars":[{"name":"M1","offset":346,"unit":1,"length":5},{"name":"M2","offset":351,"unit":1,"length":29},{"name":"FAILMSG","offset":380,"unit":1,"length":91}],"states":[{"r":[0,0,255,2070,256,65534,2332,65534,2070,2070,2070,2070,256,29186],"line":0,"text":"mov  ah,05","bytes":"B405","data":"676f7420242062797465733a2024731150ba7c01b409cd2158e81500b8014ccd21c36661696c65643a206572726f72202451528af0b104d2e8b90200240f04303c39760204078ad0b402cd218ac6e2ec5a59c3535152bb0a0033c933d2f7f352410bc075f65a80c230b402cd21e2f65a595bc353bb0100b440cd215bc3","stack":"0000","out":"","acc":[]},{"r":[1280,0,255,2070,256,65534,2332,65534,2070,2070,2070,2070,258,29186],"line":1,"text":"mov  cx,2348","bytes":"B94823","data":"676f7420242062797465733a2024731150ba7c01b409cd2158e81500b8014ccd21c36661696c65643a206572726f72202451528af0b104d2e8b90200240f04303c39760204078ad0b402cd218ac6e2ec5a59c3535152bb0a0033c933d2f7f352410bc075f65a80c230b402cd21e2f65a595bc353bb0100b440cd215bc3","stack":"0000","out":"","acc":[]},{"r":[1280,0,9032,2070,256,65534,2332,65534,2070,2070,2070,2070,261,29186],"line":2,"text":"int  16","bytes":"CD16","data":"676f7420242062797465733a2024731150ba7c01b409cd2158e81500b8014ccd21c36661696c65643a206572726f72202451528af0b104d2e8b90200240f04303c39760204078ad0b402cd218ac6e2ec5a59c3535152bb0a0033c933d2f7f352410bc075f65a80c230b402cd21e2f65a595bc353bb0100b440cd215bc3","stack":"0000","out":"","acc":[]},{"r":[1280,0,9032,2070,256,65534,2332,65534,2070,2070,2070,2070,263,29186],"line":3,"text":"mov  ah,05","bytes":"B405","data":"676f7420242062