{"v":3,"src":"MOV     AH, 4Ah          ; make room for a child\nMOV     BX, 1000h\nINT     21h\nMOV     AH, 3Ch          ; DOS: create TEST.COM\nXOR     CX, CX           ; a normal file\nMOV     DX, OFFSET PROG1\nINT     21h\nJC      DONE1\nMOV     BX, AX           ; the handle\nMOV     AH, 40h          ; DOS: write the child, five bytes\nMOV     CX, 5\nMOV     DX, OFFSET CHILD1\nINT     21h\nMOV     AH, 3Eh          ; DOS: close it\nINT     21h\nMOV     TAILP1+2, CS\nMOV     FCB1P+2, CS\nMOV     FCB2P+2, CS\nMOV     SAVESP1, SP\nMOV     AX, 4B00h        ; DOS: run it\nMOV     DX, OFFSET PROG1\nMOV     BX, OFFSET ENV1  ; ES:BX = the parameter block\nINT     21h\nMOV     BX, CS           ; MOV leaves CF alone: segments back first\nMOV     SS, BX\nMOV     SP, CS:SAVESP1\nMOV     DS, BX\nMOV     ES, BX\nJC      GONE1            ; it did not run\nMOV     DX, OFFSET CODEM1\nMOV     AH, 09h\nINT     21h\nMOV     AH, 4Dh          ; DOS: how did the child end?\nINT     21h              ; AL = its code, AH = 0: through 4Ch\nCALL    PHEX\nMOV     DX, OFFSET CRLF\nMOV     AH, 09h\nINT     21h\nGONE1:\nMOV     AH, 41h          ; DOS: delete TEST.COM\nMOV     DX, OFFSET PROG1\nINT     21h\nDONE1:\n\nPROG1   DB      \"TEST.COM\", 0\nCHILD1  DB      0B8h, 07h, 4Ch, 0CDh, 21h ; MOV AX, 4C07h / INT 21h\nTAIL1   DB      0, 13            ; an empty command tail\nENV1    DW      0                ; parameter block: environment, 0 = a copy of ours\nTAILP1  DW      OFFSET TAIL1, 0  ; the command tail, offset and segment\nFCB1P   DW      5Ch, 0           ; FCB 1: the one in our PSP\nFCB2P   DW      6Ch, 0           ; FCB 2\nSAVESP1 DW      0\nCODEM1  DB      \"the child returned AX = $\"\nPHEX    PROC    NEAR     ; print AX as four hex digits (changes AX BX CX DX)\nMOV     BX, AX\nMOV     CX, 4\nPHEX1:\nPUSH    CX\nMOV     CL, 4\nROL     BX, CL           ; the top digit to the bottom\nPOP     CX\nMOV     DL, BL\nAND     DL, 0Fh\nADD     DL, \"0\"\nCMP     DL, \"9\"\nJBE     PHEX2\nADD     DL, 7            ; \"A\" to \"F\"\nPHEX2:\nMOV     AH, 02h\nINT     21h\nLOOP    PHEX1\nRET\nPHEX    ENDP\nCRLF    DB      13, 10, \"$\"","seg":2070,"dataAt":365,"vars":[{"name":"PROG1","offset":365,"unit":1,"length":9},{"name":"CHILD1","offset":374,"unit":1,"length":5},{"name":"TAIL1","offset":379,"unit":1,"length":2},{"name":"ENV1","offset":381,"unit":2,"length":2},{"name":"TAILP1","offset":383,"unit":2,"length":4},{"name":"FCB1P","offset":387,"unit":2,"length":4},{"name":"FCB2P","offset":391,"unit":2,"length":4},{"name":"SAVESP1","offset":395,"unit":2,"length":2},{"name":"CODEM1","offset":397,"unit":1,"length":59},{"name":"CRLF","offset":456,"unit":1,"length":3}],"image":"","states":[{"r":[0,0,255,2070,256,65534,2332,65534,2070,2070,2070,2070,256,29186],"line":0,"text":"mov  ah,4A","bytes":"B44A","data":"544553542e434f4d00b8074ccd21000d00007b0100005c0000006c0000000000746865206368696c642072657475726e6564204158203d20248bd8b9040051b104d3c3598ad380e20f80c23080fa39760380c207b402cd21e2e4c30d0a24","stack":"0000","out":"","acc":[]},{"r":[18944,0,255,2070,256,65534,2332,65534,2070,2070,2070,2070,258,29186],"line":1,"text":"mov  bx,1000","bytes":"BB0010","data":"544553542e434f4d00b8074ccd21000d00007b0100005c0000006c0000000000746865206368696c642072657475726e6564204158203d20248bd8b9040051b104d3c3598ad380e20f80c23080fa39760380c207b402cd21e2e4c30d0a24","stack":"0000","out":"","acc":[]},{"r":[18944,4096,255,2070,256,65534,2332,65534,2070,2070,2070,2070,261,29186],"line":2,"text":"int  21","bytes":"CD21","data":"544553542e434f4d00b8074ccd21000d00007b0100005c0000006c0000000000746865206368696c642072657475726e6564204158203d20248bd8b9040051b104d3c3598ad380e20f80c23080fa39760380c207b402cd21e2e4c30d0a24","stack":"0000","out":"","acc":[]},{"r":[2070,4096,255,2070,256,65534,2332,65534,2070,2070,2070,2070,263,29186],"line":3,"text":"mov  ah,3C","bytes":"B43C","data":"544553542e434f4d00b8074ccd21000d00007b0100005c0000006c0000000000746865206368696c642072657475726e6564204158203d20248bd8b904