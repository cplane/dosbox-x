{"v":1,"src":"MOV     AH, 19h          ; DOS: the current drive in AL, 0 = A\nINT     21h\nMOV     OLD1, AL         ; to come back to\nCALL    PDRV\nMOV     AH, 0Eh          ; DOS: select drive DL\nMOV     DL, 25           ; 25 = Z:, DOSBox-X's own drive\nINT     21h\nMOV     COUNT1, AL       ; AL = the number of drive letters\nMOV     DX, OFFSET ARROW1\nMOV     AH, 09h\nINT     21h\nMOV     AH, 19h          ; did it work?\nINT     21h\nCALL    PDRV\nMOV     AH, 0Eh          ; back to the old drive\nMOV     DL, OLD1\nINT     21h\nMOV     DX, OFFSET ARROW1\nMOV     AH, 09h\nINT     21h\nMOV     AH, 19h\nINT     21h\nCALL    PDRV\nMOV     DX, OFFSET COUNTM1\nMOV     AH, 09h\nINT     21h\nMOV     AL, COUNT1\nMOV     AH, 0\nCALL    PDEC\nMOV     DX, OFFSET CRLF\nMOV     AH, 09h\nINT     21h\n\nOLD1    DB      0\nCOUNT1  DB      0\nARROW1  DB      \" -> $\"\nCOUNTM1 DB      \", drive letters: $\"\nCRLF    DB      13, 10, \"$\"\nPDRV    PROC    NEAR     ; print drive AL (0 = A) as \"C:\"\nADD     AL, \"A\"\nMOV     DL, AL\nMOV     AH, 02h\nINT     21h\nMOV     DL, \":\"\nMOV     AH, 02h\nINT     21h\nRET\nPDRV    ENDP\nPDEC    PROC    NEAR     ; print AX in decimal (changes AX BX CX DX)\nMOV     BX, 10\nXOR     CX, CX           ; digits on the stack\nPDEC1:\nXOR     DX, DX\nDIV     BX               ; AX = AX / 10, DX = the last digit\nPUSH    DX\nINC     CX\nOR      AX, AX\nJNZ     PDEC1\nPDEC2:\nPOP     DX               ; the digits come back first to last\nADD     DL, \"0\"\nMOV     AH, 02h\nINT     21h\nLOOP    PDEC2\nRET\nPDEC    ENDP","seg":2070,"dataAt":338,"vars":[{"name":"OLD1","offset":338,"unit":1,"length":1},{"name":"COUNT1","offset":339,"unit":1,"length":1},{"name":"ARROW1","offset":340,"unit":1,"length":5},{"name":"COUNTM1","offset":345,"unit":1,"length":18},{"name":"CRLF","offset":363,"unit":1,"length":44}],"states":[{"r":[0,0,255,2070,256,65534,2332,65534,2070,2070,2070,2070,256,29186],"line":0,"text":"mov  ah,19","bytes":"B419","data":"0000202d3e20242c2064