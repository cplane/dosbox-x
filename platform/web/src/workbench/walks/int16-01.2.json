{"v":3,"src":"FLUSH1:\nMOV     AH, 01h          ; BIOS: is a key waiting?\nINT     16h\nJZ      EMPTY1           ; ZF = 1: the buffer is empty\nMOV     AH, 00h          ; take the key out\nINT     16h\nJMP     FLUSH1\nEMPTY1:\nCALL    PEEK1            ; empty: prints -\nMOV     AH, 05h          ; store \"X\": scan 2Dh, ASCII 58h\nMOV     CX, 2D58h\nINT     16h\nCALL    PEEK1            ; 2D58\nCALL    PEEK1            ; 2D58 again: 01h leaves the key where it is\nMOV     AH, 00h          ; now take it out\nINT     16h\nCALL    PEEK1            ; empty again: -\n\nPEEK1   PROC    NEAR     ; INT 16h AH=01h, then print the key or \"-\"\nMOV     AH, 01h\nINT     16h              ; ZF = 1: nothing waiting\nJZ      NONE1\nCALL    PHEX4            ; the key, still in the buffer\nJMP     GAP1\nNONE1:\nMOV     DL, \"-\"\nMOV     AH, 02h\nINT     21h\nGAP1:\nMOV     DL, \" \"\nMOV     AH, 02h\nINT     21h\nRET\nPEEK1   ENDP\nPHEX4   PROC    NEAR     ; print AX as four hex digits; keeps every register\nPUSH    AX\nMOV     AL, AH\nCALL    PHEX2            ; the high byte first\nPOP     AX\nCALL    PHEX2            ; then the low byte\nRET\nPHEX4   ENDP\nPHEX2   PROC    NEAR     ; print AL as two hex digits; keeps every register\nPUSH    AX\nPUSH    CX\nPUSH    DX\nMOV     DH, AL           ; keep the byte\nMOV     CL, 4\nSHR     AL, CL           ; the high nibble\nCALL    HEXN1\nMOV     AL, DH\nAND     AL, 0Fh          ; the low nibble\nCALL    HEXN1\nPOP     DX\nPOP     CX\nPOP     AX\nRET\nHEXN1:\nADD     AL, \"0\"\nCMP     AL, \"9\"\nJBE     HEXN2\nADD     AL, 7            ; past \"9\": \"A\"..\"F\"\nHEXN2:\nMOV     DL, AL\nMOV     AH, 02h\nINT     21h\nRET\nPHEX2   ENDP","seg":2070,"dataAt":369,"vars":[],"image":"","states":[{"r":[0,0,255,2070,256,65534,2332,65534,2070,2070,2070,2070,256,29186],"line":1,"text":"mov  ah,01","bytes":"B401","data":"","stack":"0000","out":"","acc":[]},{"r":[256,0,255,2070,256,65534,2332,65534,2070,2070,2070,2070,258,29186],"line":2,"text":"int  