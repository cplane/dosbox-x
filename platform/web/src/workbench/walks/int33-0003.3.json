{"v":1,"src":"XOR     AX, AX           ; reset the driver\nINT     33h\nMOV     AX, 0004h        ; put the pointer on column 10, row 5\nMOV     CX, 10*8         ; x = column x 8\nMOV     DX, 5*8          ; y = row x 8\nINT     33h\nMOV     AX, 0003h        ; read position and buttons, once\nINT     33h              ; CX = x, DX = y, BX = buttons\nMOV     SI, CX           ; keep them: printing uses DX\nMOV     DI, DX\nMOV     AX, SI\nCALL    PDEC             ; x: 80\nMOV     DL, \" \"\nMOV     AH, 02h          ; DOS: print the character in DL\nINT     21h\nMOV     AX, DI\nCALL    PDEC             ; y: 40\nMOV     DL, \" \"\nMOV     AH, 02h          ; DOS: print the character in DL\nINT     21h\nMOV     AX, BX\nAND     AX, 0007h        ; the three button bits\nCALL    PDEC             ; 0: nothing pressed\nMOV     DX, OFFSET ARROW1\nMOV     AH, 09h          ; DOS: print the $-string at DS:DX\nINT     21h\nMOV     CL, 3\nMOV     AX, SI\nSHR     AX, CL           ; column = x / 8\nCALL    PDEC             ; 10\nMOV     DL, \",\"\nMOV     AH, 02h          ; DOS: print the character in DL\nINT     21h\nMOV     AX, DI\nSHR     AX, CL           ; row = y / 8\nCALL    PDEC             ; 5\n\nARROW1  DB      \" -> $\"\nPDEC    PROC    NEAR     ; print AX in decimal; keeps every register\nPUSH    AX\nPUSH    BX\nPUSH    CX\nPUSH    DX\nMOV     BX, 10\nXOR     CX, CX           ; digits on the stack\nDECD1:\nXOR     DX, DX\nDIV     BX               ; AX = AX / 10, DX = the last digit\nPUSH    DX\nINC     CX\nTEST    AX, AX\nJNZ     DECD1\nDECD2:\nPOP     DX               ; the digits come back first to last\nADD     DL, \"0\"\nMOV     AH, 02h\nINT     21h\nLOOP    DECD2\nPOP     DX\nPOP     CX\nPOP     BX\nPOP     AX\nRET\nPDEC    ENDP","seg":2070,"dataAt":344,"vars":[{"name":"ARROW1","offset":344,"unit":1,"length":39}],"states":[{"r":[0,0,255,2070,256,65534,2332,65534,2070,2070,2070,2070,256,29186],"line":0,"text":"xor  ax,ax","bytes":"33C0","data":"202d3e202450535152bb0a0033c93