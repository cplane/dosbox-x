{"v":1,"src":"MOV     SI, OFFSET KEYS1\nCALL    STUFF1           ; \"pass\" and Enter wait in the BIOS buffer\nXOR     BX, BX           ; keys so far\nNEXT1:\nMOV     AH, 08h          ; DOS: read a key, no echo\nINT     21h\nCMP     AL, 13           ; Enter ends the input\nJE      DONE1\nINC     BX\nMOV     DL, \"*\"              ; a star instead of the key\nMOV     AH, 02h          ; DOS: print the character in DL\nINT     21h\nJMP     NEXT1\nDONE1:\nMOV     DL, \" \"\nMOV     AH, 02h          ; DOS: print the character in DL\nINT     21h\nMOV     DL, BL\nADD     DL, \"0\"          ; the count as a digit\nMOV     AH, 02h          ; DOS: print the character in DL\nINT     21h\nMOV     DX, OFFSET MSG1\nMOV     AH, 09h          ; DOS: print the string at DS:DX\nINT     21h\n\nKEYS1   DW      1970h, 1E61h, 1F73h, 1F73h, 1C0Dh, 0  ; p a s s Enter\nMSG1    DB      \" keys\", 13, 10, \"$\"\nSTUFF1  PROC    NEAR     ; \"type\" the keys at DS:SI: words, 0 ends the list\nCLD\nST1:\nLODSW                    ; AH = scan code, AL = ASCII\nTEST    AX, AX\nJZ      ST2\nMOV     CX, AX           ; CH = scan code, CL = ASCII\nMOV     AH, 05h          ; BIOS: store a keystroke in the keyboard buffer\nINT     16h\nJMP     ST1\nST2:\nRET\nSTUFF1  ENDP","seg":2070,"dataAt":308,"vars":[{"name":"KEYS1","offset":308,"unit":2,"length":12},{"name":"MSG1","offset":320,"unit":1,"length":23}],"states":[{"r":[0,0,255,2070,256,65534,2332,65534,2070,2070,2070,2070,256,29186],"line":0,"text":"mov  si,0134","bytes":"BE3401","data":"7019611e731f731f0d1c0000206b6579730d0a24fcad85c074088bc8b405cd16ebf3c3","stack":"0000","out":"","acc":[]},{"r":[0,0,255,2070,308,65534,2332,65534,2070,2070,2070,2070,259,29186],"line":1,"text":"call 00000148 ($+42)","bytes":"E84200","data":"7019611e731f731f0d1c0000206b6579730d0a24fcad85c074088bc8b405cd16ebf3c3","stack":"0000","out":"","acc":[]},{"r":[0,0,255,2070,308,65534,2332,65532,2070,2070,2070,2070,328,29186],"line":28,"text":"cld","bytes":"FC","data":"7019611e731f73