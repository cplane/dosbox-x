{"v":3,"src":"MOV     AH, 02h          ; BIOS: read the real-time clock\nINT     1Ah              ; CH = hours, CL = minutes, DH = seconds, BCD\nJC      FAIL1            ; CF = 1: the clock is not running\nMOV     AL, CH\nCALL    PHEX2            ; BCD prints as decimal through the hex routine\nMOV     DL, \":\"          ; DL only: DH still holds the seconds\nMOV     AH, 02h          ; DOS: print the character in DL\nINT     21h\nMOV     AL, CL\nCALL    PHEX2\nMOV     DL, \":\"\nMOV     AH, 02h          ; DOS: print the character in DL\nINT     21h\nMOV     AL, DH\nCALL    PHEX2\nJMP     DONE1\nFAIL1:\nMOV     DX, OFFSET STOP1\nMOV     AH, 09h          ; DOS: print the $-string at DS:DX\nINT     21h\nDONE1:\n\nSTOP1   DB      \"the clock is not running$\"\nPHEX2   PROC    NEAR     ; print AL as two hex digits; keeps every register\nPUSH    AX\nPUSH    CX\nPUSH    DX\nMOV     DH, AL           ; keep the byte\nMOV     CL, 4\nSHR     AL, CL           ; the high nibble\nCALL    HEXN1\nMOV     AL, DH\nAND     AL, 0Fh          ; the low nibble\nCALL    HEXN1\nPOP     DX\nPOP     CX\nPOP     AX\nRET\nHEXN1:\nADD     AL, \"0\"\nCMP     AL, \"9\"\nJBE     HEXN2\nADD     AL, 7            ; past \"9\": \"A\"..\"F\"\nHEXN2:\nMOV     DL, AL\nMOV     AH, 02h\nINT     21h\nRET\nPHEX2   ENDP","seg":2070,"dataAt":303,"vars":[{"name":"STOP1","offset":303,"unit":1,"length":63}],"image":"","states":[{"r":[0,0,255,2070,256,65534,2332,65534,2070,2070,2070,2070,256,29186],"line":0,"text":"mov  ah,02","bytes":"B402","data":"74686520636c6f636b206973206e6f742072756e6e696e67245051528af0b104d2e8e80b008ac6240fe804005a5958c304303c39760204078ad0b402cd21c3","stack":"0000","out":"","acc":[]},{"r":[512,0,255,2070,256,65534,2332,65534,2070,2070,2070,2070,258,29186],"line":1,"text":"int  1A","bytes":"CD1A","data":"74686520636c6f636b206973206e6f742072756e6e696e67245051528af0b104d2e8e80b008ac6240fe804005a5958c304303c39760204078ad0b402cd21c3","stack":"0000","out":"","acc":[]},{"r":[512,0,5976,4865,256,65