{"v":1,"src":"MOV     AH, 47h          ; DOS: the current directory, for later\nMOV     DL, 0            ; 0 = the current drive\nMOV     SI, OFFSET OLD1+1 ; after the \"\\\" already there\nINT     21h\nMOV     AH, 3Bh          ; DOS: change the directory to DS:DX\nMOV     DX, OFFSET ROOT1 ; \"\\\": the root\nINT     21h\nCALL    PCWD             ; prints \"C:\\\"\nMOV     AH, 3Bh          ; and back: \"\\\" and the old path\nMOV     DX, OFFSET OLD1\nINT     21h\nMOV     AH, 47h          ; where are we now?\nMOV     DL, 0\nMOV     SI, OFFSET NOW1\nINT     21h\nCLD\nMOV     SI, OFFSET OLD1+1\nMOV     DI, OFFSET NOW1  ; ES = DS in a .COM\nMOV     CX, 64\nREPE    CMPSB            ; the same 64 bytes?\nMOV     DX, OFFSET BACK1\nJE      SAME1\nMOV     DX, OFFSET LOST1\nSAME1:\nMOV     AH, 09h\nINT     21h\n\nROOT1   DB      \"\\\", 0\nOLD1    DB      \"\\\", 64 DUP(0)\nNOW1    DB      64 DUP(0)\nBACK1   DB      \"back in the old directory\", 13, 10, \"$\"\nLOST1   DB      \"somewhere else\", 13, 10, \"$\"\nPCWD    PROC    NEAR     ; print the current directory: C:\\PATH\nMOV     AH, 19h          ; the drive letter\nINT     21h\nADD     AL, \"A\"\nMOV     DL, AL\nMOV     AH, 02h\nINT     21h\nMOV     DL, \":\"\nMOV     AH, 02h\nINT     21h\nMOV     DL, \"\\\"\nMOV     AH, 02h\nINT     21h\nMOV     AH, 47h          ; the directory, without \"\\\" in front\nMOV     DL, 0\nMOV     SI, OFFSET DIRBUF\nINT     21h\nCLD\nPCWD1:\nLODSB\nOR      AL, AL\nJZ      PCWD2\nMOV     DL, AL\nMOV     AH, 02h\nINT     21h\nJMP     PCWD1\nPCWD2:\nMOV     DX, OFFSET CRLF\nMOV     AH, 09h\nINT     21h\nRET\nPCWD    ENDP\nDIRBUF  DB      64 DUP(0)\nCRLF    DB      13, 10, \"$\"","seg":2070,"dataAt":320,"vars":[{"name":"ROOT1","offset":320,"unit":1,"length":2},{"name":"OLD1","offset":322,"unit":1,"length":129},{"name":"BACK1","offset":451,"unit":1,"length":28},{"name":"LOST1","offset":479,"unit":1,"length":136},{"name":"CRLF","offset":615,"unit":1,"length":3}],"states":[{"r":[0,0,255,2070,256,65