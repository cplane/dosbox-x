{"v":3,"src":"MOV     AX, 1A00h        ; get the display combination code\nINT     10h\nCMP     AL, 1Ah          ; does the BIOS know the function?\nJNE     OLD1\nMOV     [DCC1], BX       ; BL = active, BH = alternate\nMOV     AH, 09h\nMOV     DX, OFFSET TXT1\nINT     21h\nMOV     AL, BYTE PTR [DCC1] ; the active display\nCALL    PHEX2\nMOV     AH, 09h\nMOV     DX, OFFSET TXT2\nINT     21h\nMOV     AL, BYTE PTR [DCC1+1] ; the alternate\nCALL    PHEX2\nMOV     DX, OFFSET TXT3\nJMP     LAST1\nOLD1:\nMOV     DX, OFFSET TXT4  ; an EGA or older\nLAST1:\nMOV     AH, 09h\nINT     21h\n\nDCC1    DW      0\nTXT1    DB      \"active $\"\nTXT2    DB      \"h, alternate $\"\nTXT3    DB      \"h\", 13, 10, \"$\"\nTXT4    DB      \"no VGA BIOS\", 13, 10, \"$\"\nPHEX2:                   ; print AL as two hex digits; changes AX, CX, DX\nPUSH    AX\nMOV     CL, 4\nSHR     AL, CL           ; the high nibble first\nCALL    PDIG1\nPOP     AX\nAND     AL, 0Fh          ; then the low one, falling into PDIG1\nPDIG1:\nADD     AL, \"0\"\nCMP     AL, \"9\"\nJBE     PDIG2\nADD     AL, 7            ; \"A\"..\"F\"\nPDIG2:\nMOV     DL, AL\nMOV     AH, 02h          ; DOS: print DL\nINT     21h\nRET","seg":2070,"dataAt":312,"vars":[{"name":"DCC1","offset":312,"unit":2,"length":2},{"name":"TXT1","offset":314,"unit":1,"length":8},{"name":"TXT2","offset":322,"unit":1,"length":14},{"name":"TXT3","offset":336,"unit":1,"length":4},{"name":"TXT4","offset":340,"unit":1,"length":40}],"image":"","states":[{"r":[0,0,255,2070,256,65534,2332,65534,2070,2070,2070,2070,256,29186],"line":0,"text":"mov  ax,1A00","bytes":"B8001A","data":"00006163746976652024682c20616c7465726e6174652024680d0a246e6f205647412042494f530d0a2450b104d2e8e8030058240f04303c39760204078ad0b402cd21c3","stack":"0000","out":"","acc":[]},{"r":[6656,0,255,2070,256,65534,2332,65534,2070,2070,2070,2070,259,29186],"line":1,"text":"int  10","bytes":"CD10","data":"00006163746976652024682c20616c7465726e6174652024680d0a246e6f205647412042494f530d0a2450b10