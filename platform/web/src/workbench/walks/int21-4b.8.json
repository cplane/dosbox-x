{"v":3,"src":"MOV     AH, 4Ah          ; DOS: shrink our block (ES = our PSP)\nMOV     BX, 1000h        ; to 64 KB: the .COM and its stack\nINT     21h\nMOV     TAILP1+2, CS     ; the segments of the block's pointers\nMOV     FCB1P+2, CS\nMOV     FCB2P+2, CS\nMOV     SAVESP1, SP      ; DOS 2 lost SS:SP over an EXEC\nMOV     AX, 4B00h        ; DOS: EXEC, AL = 0: load and run\nMOV     DX, OFFSET PROG1 ; DS:DX = the program\nMOV     BX, OFFSET ENV1  ; ES:BX = the parameter block\nINT     21h\nMOV     BX, CS           ; MOV leaves CF alone: segments back first\nMOV     SS, BX\nMOV     SP, CS:SAVESP1\nMOV     DS, BX\nMOV     ES, BX\nPUSHF                    ; keep CF while printing\nMOV     DX, OFFSET BACKM1\nMOV     AH, 09h\nINT     21h\nPOPF\nCALL    RESULT           ; ok, or the error code\n\nPROG1   DB      \"Z:\\COMMAND.COM\", 0\nTAIL1   DB      27, \" /C ECHO hello from a child\", 13 ; 27 characters, CR not counted\nENV1    DW      0                ; parameter block: environment, 0 = a copy of ours\nTAILP1  DW      OFFSET TAIL1, 0  ; the command tail, offset and segment\nFCB1P   DW      5Ch, 0           ; FCB 1: the one in our PSP\nFCB2P   DW      6Ch, 0           ; FCB 2\nSAVESP1 DW      0\nBACKM1  DB      \"back in the parent: $\"\nRESULT  PROC    NEAR     ; print \"ok\", or \"error\" and AX when CF = 1\nPUSHF                    ; keeps AX and CF for the caller\nPUSH    AX\nMOV     DX, OFFSET OKMSG\nJNC     RESULT1\nMOV     DX, OFFSET ERRMSG\nMOV     AH, 09h\nINT     21h\nPOP     AX\nPUSH    AX\nCALL    PDEC             ; the error code\nMOV     DX, OFFSET CRLF\nRESULT1:\nMOV     AH, 09h\nINT     21h\nPOP     AX\nPOPF\nRET\nRESULT  ENDP\nOKMSG   DB      \"ok\", 13, 10, \"$\"\nERRMSG  DB      \"error $\"\nPDEC    PROC    NEAR     ; print AX in decimal (changes AX BX CX DX)\nMOV     BX, 10\nXOR     CX, CX           ; digits on the stack\nPDEC1:\nXOR     DX, DX\nDIV     BX               ; AX = AX / 10, DX = the last digit\nPUSH    DX\nINC     CX\nOR      AX, AX\nJNZ     PDEC1\nPDEC2:\nPOP     DX               ; the digits come back first to last\nADD     DL, \"0\"\nMOV     AH, 02h\nINT     21h\nLOOP    PDEC2\nRET\nPDEC    ENDP\nCRLF    DB      13, 10, \"$\"","seg":2070,"dataAt":320,"vars":[{"name":"PROG1","offset":320,"unit":1,"length":15},{"name":"TAIL1","offset":335,"unit":1,"length":29},{"name":"ENV1","offset":364,"unit":2,"length":2},{"name":"TAILP1","offset":366,"unit":2,"length":4},{"name":"FCB1P","offset":370,"unit":2,"length":4},{"name":"FCB2P","offset":374,"unit":2,"length":4},{"name":"SAVESP1","offset":378,"unit":2,"length":2},{"name":"BACKM1","offset":380,"unit":1,"length":50},{"name":"OKMSG","offset":430,"unit":1,"length":5},{"name":"ERRMSG","offset":435,"unit":1,"length":33},{"name":"CRLF","offset":468,"unit":1,"length":3}],"image":"","states":[{"r":[0,0,255,2070,256,65534,2332,65534,2070,2070,2070,2070,256,29186],"line":0,"text":"mov  ah,4A","bytes":"B44A","data":"","stack":"0000","out":"","acc":[]},{"r":[18944,0,255,2070,256,65534,2332,65534,2070,2070,2070,2070,258,29186],"line":1,"text":"mov  bx,1000","bytes":"BB0010","data":"","stack":"0000","out":"","acc":[]},{"r":[18944,4096,255,2070,256,65534,2332,65534,2070,2070,2070,2070,261,29186],"line":2,"text":"int  21","bytes":"CD21","data":"","stack":"0000","out":"","acc":[]},{"r":[2070,4096,255,2070,256,65534,2332,65534,2070,2070,2070,2070,263,29186],"line":3,"text":"mov  [0170],cs","bytes":"8C0E7001","data":"","stack":"0000","out":"","acc":[]},{"r":[2070,4096,255,2070,256,65534,2332,65534,2070,2070,2070,2070,267,29186],"line":4,"text":"mov  [0174],cs","bytes":"8C0E7401","data":"","stack":"0000","out":"","acc":[[33488,2,1]]},{"r":[2070,4096,255,2070,256,65534,2332,65534,2070,2070,2070,2070,271,29186],"line":5,"text":"mov  [0178],cs","bytes":"8C0E7801","data":"","stack":"0000","out":"","acc":[[33492,2,1]]},{"r":[2070,4096,255,2070,256,65534,2332,65534,2070,2070,2070,2070,275,29186],"line":6,"text":"mov  [017A],sp","bytes":"89267A01","data":"","stack":"0000","out":""