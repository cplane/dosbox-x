{"v":3,"src":"MOV     AX, 3D00h        ; DOS: open a file, AL = 0: for reading\nMOV     DX, OFFSET FNAME1 ; DS:DX = the name, ending in a 0 byte\nINT     21h\nJNC     OPENED1          ; CF = 0: AX = a handle\nPUSH    AX               ; CF = 1: AX = the error code\nMOV     DX, OFFSET FAIL1\nMOV     AH, 09h          ; DOS: print the string at DS:DX\nINT     21h\nPOP     AX\nCALL    HEX2             ; 02: file not found\nMOV     DL, \"h\"\nMOV     AH, 02h          ; DOS: print the character in DL\nINT     21h\nJMP     DONE1\nOPENED1:\nMOV     BX, AX           ; it exists after all: close it\nMOV     AH, 3Eh\nINT     21h\nMOV     DX, OFFSET OK1\nMOV     AH, 09h          ; DOS: print the string at DS:DX\nINT     21h\nDONE1:\n\nFNAME1  DB      \"NOSUCH.XYZ\", 0\nFAIL1   DB      \"open failed, error $\"\nOK1     DB      \"opened\", 13, 10, \"$\"\nHEX2    PROC    NEAR     ; print AL as two hex digits\nPUSH    AX\nMOV     CL, 4\nSHR     AL, CL           ; the high digit first\nCALL    NIB1\nPOP     AX\nAND     AL, 0Fh          ; then the low one\nCALL    NIB1\nRET\nHEX2    ENDP\nNIB1    PROC    NEAR     ; print AL (0-15) as one hex digit\nADD     AL, \"0\"\nCMP     AL, \"9\"\nJBE     NIB2\nADD     AL, 7            ; 10-15 become \"A\"-\"F\"\nNIB2:\nMOV     DL, AL\nMOV     AH, 02h\nINT     21h\nRET\nNIB1    ENDP","seg":2070,"dataAt":304,"vars":[{"name":"FNAME1","offset":304,"unit":1,"length":11},{"name":"FAIL1","offset":315,"unit":1,"length":20},{"name":"OK1","offset":335,"unit":1,"length":39}],"image":"","states":[{"r":[0,0,255,2070,256,65534,2332,65534,2070,2070,2070,2070,256,29186],"line":0,"text":"mov  ax,3D00","bytes":"B8003D","data":"4e4f535543482e58595a006f70656e206661696c65642c206572726f7220246f70656e65640d0a2450b104d2e8e8070058240fe80100c304303c39760204078ad0b402cd21c3","stack":"0000","out":"","acc":[]},{"r":[15616,0,255,2070,256,65534,2332,65534,2070,2070,2070,2070,259,29186],"line":1,"text":"mov  dx,0130","bytes":"BA3001","data":"4e4f535543482e58595a006f70656e20666