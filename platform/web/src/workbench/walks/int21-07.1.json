{"v":3,"src":"MOV     SI, OFFSET KEYS1\nCALL    STUFF1           ; Ctrl+C, then F1\nMOV     AH, 07h          ; DOS: read a key, no echo, no Ctrl+C check\nINT     21h              ; AL = 03h: Ctrl+C, an ordinary key here\nCALL    HEX2\nMOV     DL, \" \"\nMOV     AH, 02h          ; DOS: print the character in DL\nINT     21h\nMOV     AH, 07h\nINT     21h              ; AL = 00h: a special key, the scan code follows\nCALL    HEX2\nMOV     DL, \" \"\nMOV     AH, 02h          ; DOS: print the character in DL\nINT     21h\nMOV     AH, 07h\nINT     21h              ; AL = 3Bh: the scan code of F1\nCALL    HEX2\n\nKEYS1   DW      2E03h, 3B00h, 0  ; Ctrl+C, F1: scan code and ASCII\nSTUFF1  PROC    NEAR     ; \"type\" the keys at DS:SI: words, 0 ends the list\nCLD\nST1:\nLODSW                    ; AH = scan code, AL = ASCII\nTEST    AX, AX\nJZ      ST2\nMOV     CX, AX           ; CH = scan code, CL = ASCII\nMOV     AH, 05h          ; BIOS: store a keystroke in the keyboard buffer\nINT     16h\nJMP     ST1\nST2:\nRET\nSTUFF1  ENDP\nHEX2    PROC    NEAR     ; print AL as two hex digits\nPUSH    AX\nMOV     CL, 4\nSHR     AL, CL           ; the high digit first\nCALL    NIB1\nPOP     AX\nAND     AL, 0Fh          ; then the low one\nCALL    NIB1\nRET\nHEX2    ENDP\nNIB1    PROC    NEAR     ; print AL (0-15) as one hex digit\nADD     AL, \"0\"\nCMP     AL, \"9\"\nJBE     NIB2\nADD     AL, 7            ; 10-15 become \"A\"-\"F\"\nNIB2:\nMOV     DL, AL\nMOV     AH, 02h\nINT     21h\nRET\nNIB1    ENDP","seg":2070,"dataAt":300,"vars":[{"name":"KEYS1","offset":300,"unit":2,"length":51}],"image":"","states":[{"r":[0,0,255,2070,256,65534,2332,65534,2070,2070,2070,2070,256,29186],"line":0,"text":"mov  si,012C","bytes":"BE2C01","data":"032e003b0000fcad85c074088bc8b405cd16ebf3c350b104d2e8e8070058240fe80100c304303c39760204078ad0b402cd21c3","stack":"0000","out":"","acc":[]},{"r":[0,0,255,2070,300,65534,2332,65534,2070,2070,2070,2070,259,29186],"line":1,"text":"call 00000132 ($+2c)","bytes":"E