{"v":1,"src":"MOV     AX, 351Ch        ; DOS: get vector 1Ch, the timer hook\nINT     21h              ; ES:BX = the current handler\nMOV     WORD PTR OLD1C1, BX\nMOV     WORD PTR OLD1C1+2, ES\nMOV     AX, 251Ch        ; DOS: set vector 1Ch\nMOV     DX, OFFSET TICK1 ; DS:DX = our handler (DS = CS in a .COM)\nINT     21h\nWAIT1:\nCMP     WORD PTR TICKS1, 18 ; 18 ticks: about one second\nJB      WAIT1\nPUSH    DS\nLDS     DX, OLD1C1       ; DS:DX = the old handler\nMOV     AX, 251Ch        ; put it back\nINT     21h\nPOP     DS\nMOV     DX, OFFSET MSG1\nMOV     AH, 09h          ; DOS: print the string at DS:DX\nINT     21h\n\nOLD1C1  DD      0        ; the old vector: offset, then segment\nTICKS1  DW      0\nTICK1   PROC    FAR      ; INT 1Ch: called 18.2 times a second\nINC     CS:TICKS1        ; DS is not ours in here: go through CS\nJMP     DWORD PTR CS:OLD1C1 ; chain to the old handler; it ends with IRET\nTICK1   ENDP\nMSG1    DB      \"18 timer ticks counted, INT 1Ch restored\", 13, 10, \"$\"","seg":2103,"dataAt":311,"vars":[{"name":"TICKS1","offset":311,"unit":2,"length":12},{"name":"MSG1","offset":323,"unit":1,"length":43}],"states":[{"r":[0,0,255,2103,256,65534,2332,65534,2103,2103,2103,2103,256,29186],"line":0,"text":"mov  ax,351C","bytes":"B81C35","data":"00002eff0637012eff2e330131382074696d6572207469636b7320636f756e7465642c20494e542031436820726573746f7265640d0a24","stack":"0000","out":"","acc":[]},{"r":[13596,0,255,2103,256,65534,2332,65534,2103,2103,2103,2103,259,29186],"line":1,"text":"int  21","bytes":"CD21","data":"00002eff0637012eff2e330131382074696d6572207469636b7320636f756e7465642c20494e542031436820726573746f7265640d0a24","stack":"0000","out":"","acc":[]},{"r":[13596,52224,255,2103,256,65534,2332,65534,2103,2103,61440,2103,261,29186],"line":2,"text":"mov  [0133],bx","bytes":"891E3301","data":"00002eff0637012eff2e330131382074696d6572207469636b7320636f756e7465642c20494e542031436820726573746f7265640d0a24","stack":"0000","out":"","acc":[]},{"r":[13596,52