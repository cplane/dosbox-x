{"v":3,"src":"MOV     AH, 05h          ; put \"A\" in the buffer: scan 1Eh, ASCII 41h\nMOV     CX, 1E41h\nINT     16h\nMOV     AH, 05h          ; and F1: scan 3Bh, no ASCII\nMOV     CX, 3B00h\nINT     16h\nMOV     AH, 00h          ; BIOS: wait for a key (one is there)\nINT     16h              ; AH = scan code, AL = ASCII\nCALL    PHEX4            ; 1E41\nMOV     DL, \" \"\nMOV     AH, 02h          ; DOS: print the character in DL\nINT     21h\nMOV     AH, 00h\nINT     16h              ; F1: AL = 0 marks a key without a character\nCALL    PHEX4            ; 3B00\n\nPHEX4   PROC    NEAR     ; print AX as four hex digits; keeps every register\nPUSH    AX\nMOV     AL, AH\nCALL    PHEX2            ; the high byte first\nPOP     AX\nCALL    PHEX2            ; then the low byte\nRET\nPHEX4   ENDP\nPHEX2   PROC    NEAR     ; print AL as two hex digits; keeps every register\nPUSH    AX\nPUSH    CX\nPUSH    DX\nMOV     DH, AL           ; keep the byte\nMOV     CL, 4\nSHR     AL, CL           ; the high nibble\nCALL    HEXN1\nMOV     AL, DH\nAND     AL, 0Fh          ; the low nibble\nCALL    HEXN1\nPOP     DX\nPOP     CX\nPOP     AX\nRET\nHEXN1:\nADD     AL, \"0\"\nCMP     AL, \"9\"\nJBE     HEXN2\nADD     AL, 7            ; past \"9\": \"A\"..\"F\"\nHEXN2:\nMOV     DL, AL\nMOV     AH, 02h\nINT     21h\nRET\nPHEX2   ENDP","seg":2070,"dataAt":344,"vars":[],"image":"","states":[{"r":[0,0,255,2070,256,65534,2332,65534,2070,2070,2070,2070,256,29186],"line":0,"text":"mov  ah,05","bytes":"B405","data":"","stack":"0000","out":"","acc":[]},{"r":[1280,0,255,2070,256,65534,2332,65534,2070,2070,2070,2070,258,29186],"line":1,"text":"mov  cx,1E41","bytes":"B9411E","data":"","stack":"0000","out":"","acc":[]},{"r":[1280,0,7745,2070,256,65534,2332,65534,2070,2070,2070,2070,261,29186],"line":2,"text":"int  16","bytes":"CD16","data":"","stack":"0000","out":"","acc":[]},{"r":[1280,0,7745,2070,256,65534,2332,65534,2070,2070,2070,2070,263,29186],"line":3,"text":"mov  ah,05","bytes":"B405","data":