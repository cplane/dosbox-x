{"v":1,"src":"MOV     AH, 0Bh          ; DOS: is a key waiting?\nINT     21h              ; AL = 00h: the buffer is empty\nCALL    HEX2\nMOV     CX, 2D78h        ; \"x\": scan code 2Dh, ASCII 78h\nMOV     AH, 05h          ; BIOS: store a keystroke in the keyboard buffer\nINT     16h\nMOV     DL, \" \"\nMOV     AH, 02h          ; DOS: print the character in DL\nINT     21h\nMOV     AH, 0Bh\nINT     21h              ; AL = FFh: now there is one\nCALL    HEX2\nMOV     DL, \" \"\nMOV     AH, 02h          ; DOS: print the character in DL\nINT     21h\nMOV     AH, 07h          ; 0Bh left the key there: take it out\nINT     21h\nMOV     DL, AL\nMOV     AH, 02h          ; DOS: print the character in DL\nINT     21h\n\nHEX2    PROC    NEAR     ; print AL as two hex digits\nPUSH    AX\nMOV     CL, 4\nSHR     AL, CL           ; the high digit first\nCALL    NIB1\nPOP     AX\nAND     AL, 0Fh          ; then the low one\nCALL    NIB1\nRET\nHEX2    ENDP\nNIB1    PROC    NEAR     ; print AL (0-15) as one hex digit\nADD     AL, \"0\"\nCMP     AL, \"9\"\nJBE     NIB2\nADD     AL, 7            ; 10-15 become \"A\"-\"F\"\nNIB2:\nMOV     DL, AL\nMOV     AH, 02h\nINT     21h\nRET\nNIB1    ENDP","seg":2070,"dataAt":334,"vars":[],"states":[{"r":[0,0,255,2070,256,65534,2332,65534,2070,2070,2070,2070,256,29186],"line":0,"text":"mov  ah,0B","bytes":"B40B","data":"","stack":"0000","out":"","acc":[]},{"r":[2816,0,255,2070,256,65534,2332,65534,2070,2070,2070,2070,258,29186],"line":1,"text":"int  21","bytes":"CD21","data":"","stack":"0000","out":"","acc":[]},{"r":[2816,0,255,2070,256,65534,2332,65534,2070,2070,2070,2070,260,29186],"line":2,"text":"call 00000130 ($+29)","bytes":"E82900","data":"","stack":"0000","out":"","acc":[]},{"r":[2816,0,255,2070,256,65534,2332,65532,2070,2070,2070,2070,304,29186],"line":22,"text":"push ax","bytes":"50","data":"","stack":"07010000","out":"","acc":[[98652,2,1]]},{"r":[2816,0,255,2070,256,65534,2332,65530,2070,2070,2070,2070,305,29186],"line":23,"text":"mov  c