{"v":1,"src":"MOV     AX, 0000h        ; mouse: reset and detect\nINT     33h              ; AX = FFFFh: yes, BX = buttons\nCALL    PHEX4            ; FFFF\nMOV     DL, \" \"\nMOV     AH, 02h          ; DOS: print the character in DL\nINT     21h\nMOV     AX, BX\nCALL    PHEX4            ; 0003 here\nMOV     DL, \" \"\nMOV     AH, 02h          ; DOS: print the character in DL\nINT     21h\nMOV     AX, 0003h        ; where did the reset put the pointer?\nINT     33h              ; CX = x, DX = y\nMOV     BX, DX           ; keep y: printing uses DL\nMOV     AX, CX\nCALL    PDEC             ; 320: half of 640\nMOV     DL, \" \"\nMOV     AH, 02h          ; DOS: print the character in DL\nINT     21h\nMOV     AX, BX\nCALL    PDEC             ; 96: 100 rounded down to a text row\n\nPHEX4   PROC    NEAR     ; print AX as four hex digits; keeps every register\nPUSH    AX\nMOV     AL, AH\nCALL    PHEX2            ; the high byte first\nPOP     AX\nCALL    PHEX2            ; then the low byte\nRET\nPHEX4   ENDP\nPHEX2   PROC    NEAR     ; print AL as two hex digits; keeps every register\nPUSH    AX\nPUSH    CX\nPUSH    DX\nMOV     DH, AL           ; keep the byte\nMOV     CL, 4\nSHR     AL, CL           ; the high nibble\nCALL    HEXN1\nMOV     AL, DH\nAND     AL, 0Fh          ; the low nibble\nCALL    HEXN1\nPOP     DX\nPOP     CX\nPOP     AX\nRET\nHEXN1:\nADD     AL, \"0\"\nCMP     AL, \"9\"\nJBE     HEXN2\nADD     AL, 7            ; past \"9\": \"A\"..\"F\"\nHEXN2:\nMOV     DL, AL\nMOV     AH, 02h\nINT     21h\nRET\nPHEX2   ENDP\nPDEC    PROC    NEAR     ; print AX in decimal; keeps every register\nPUSH    AX\nPUSH    BX\nPUSH    CX\nPUSH    DX\nMOV     BX, 10\nXOR     CX, CX           ; digits on the stack\nDECD1:\nXOR     DX, DX\nDIV     BX               ; AX = AX / 10, DX = the last digit\nPUSH    DX\nINC     CX\nTEST    AX, AX\nJNZ     DECD1\nDECD2:\nPOP     DX               ; the digits come back first to last\nADD     DL, \"0\"\nMOV     AH, 02h\nINT     21h\nLOOP    