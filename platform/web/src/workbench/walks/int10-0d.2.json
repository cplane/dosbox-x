{"v":1,"src":"MOV     AX, 0013h        ; 320x200, 256 colours: all pixels 0\nINT     10h\nMOV     AX, 0C0Eh        ; write a pixel, colour 0Eh (yellow)\nMOV     BH, 0\nMOV     CX, 10           ; x\nMOV     DX, 10           ; y\nINT     10h\nMOV     AH, 0Dh          ; read it back\nMOV     BH, 0\nMOV     CX, 10\nMOV     DX, 10\nINT     10h              ; AL = its colour\nMOV     [PIX1], AL\nMOV     AH, 0Dh          ; and its neighbour, never drawn\nMOV     BH, 0\nMOV     CX, 11\nMOV     DX, 10\nINT     10h\nMOV     [PIX2], AL\nMOV     CX, 001Eh        ; wait 2 s: CX:DX = 1E8480h microseconds\nMOV     DX, 8480h\nMOV     AH, 86h          ; BIOS: wait\nINT     15h\nMOV     AX, 0003h        ; mode 03h again: 80x25 text, clears the screen\nINT     10h\nMOV     AH, 09h\nMOV     DX, OFFSET TXT1\nINT     21h\nMOV     AL, [PIX1]\nCALL    PHEX2\nMOV     AH, 09h\nMOV     DX, OFFSET TXT2\nINT     21h\nMOV     AL, [PIX2]\nCALL    PHEX2\nMOV     AH, 09h\nMOV     DX, OFFSET TXT3\nINT     21h\n\nPIX1    DB      0\nPIX2    DB      0\nTXT1    DB      \"pixel 10,10 = $\"\nTXT2    DB      \"h, pixel 11,10 = $\"\nTXT3    DB      \"h\", 13, 10, \"$\"\nPHEX2:                   ; print AL as two hex digits; changes AX, CX, DX\nPUSH    AX\nMOV     CL, 4\nSHR     AL, CL           ; the high nibble first\nCALL    PDIG1\nPOP     AX\nAND     AL, 0Fh          ; then the low one, falling into PDIG1\nPDIG1:\nADD     AL, \"0\"\nCMP     AL, \"9\"\nJBE     PDIG2\nADD     AL, 7            ; \"A\"..\"F\"\nPDIG2:\nMOV     DL, AL\nMOV     AH, 02h          ; DOS: print DL\nINT     21h\nRET","seg":2070,"dataAt":357,"vars":[{"name":"PIX1","offset":357,"unit":1,"length":1},{"name":"PIX2","offset":358,"unit":1,"length":1},{"name":"TXT1","offset":359,"unit":1,"length":15},{"name":"TXT2","offset":374,"unit":1,"length":18},{"name":"TXT3","offset":392,"unit":1,"length":30}],"states":[{"r":[0,0,255,2070,256,65534,2332,65534,2070,2070,2070,2070,256,29186],"line":0,"text":"mov  ax,0013","bytes":"B81300","data":"00007