{"v":3,"src":"MOV     AX, 3000h        ; DOS: get the version; AL = 0: OEM number in BH\nINT     21h              ; AL = major, AH = minor\nPUSH    AX\nMOV     DX, OFFSET MSG1\nMOV     AH, 09h          ; DOS: print the string at DS:DX\nINT     21h\nPOP     AX\nPUSH    AX\nXOR     AH, AH           ; AX = the major number\nCALL    PDEC1\nMOV     DL, \".\"\nMOV     AH, 02h          ; DOS: print the character in DL\nINT     21h\nPOP     AX\nMOV     AL, AH           ; the minor number: always two digits\nCALL    P2D1\n\nMSG1    DB      \"DOS $\"\nPDEC1   PROC    NEAR     ; print AX in decimal\nMOV     BX, 10\nXOR     CX, CX           ; digits so far\nPD1:\nXOR     DX, DX\nDIV     BX               ; AX = AX / 10, DX = the last digit\nPUSH    DX\nINC     CX\nTEST    AX, AX\nJNZ     PD1\nPD2:\nPOP     DX               ; the digits come back first to last\nADD     DL, \"0\"\nMOV     AH, 02h\nINT     21h\nLOOP    PD2\nRET\nPDEC1   ENDP\nP2D1    PROC    NEAR     ; print AL (0-99) as two digits\nAAM                      ; AH = AL / 10, AL = AL mod 10\nADD     AX, 3030h        ; both digits to characters\nPUSH    AX\nMOV     DL, AH           ; the tens\nMOV     AH, 02h\nINT     21h\nPOP     DX               ; DL = the units\nMOV     AH, 02h\nINT     21h\nRET\nP2D1    ENDP","seg":2070,"dataAt":293,"vars":[{"name":"MSG1","offset":293,"unit":1,"length":49}],"image":"","states":[{"r":[0,0,255,2070,256,65534,2332,65534,2070,2070,2070,2070,256,29186],"line":0,"text":"mov  ax,3000","bytes":"B80030","data":"444f532024bb0a0033c933d2f7f3524185c075f65a80c230b402cd21e2f6c3d40a053030508ad4b402cd215ab402cd21c3","stack":"0000","out":"","acc":[]},{"r":[12288,0,255,2070,256,65534,2332,65534,2070,2070,2070,2070,259,29186],"line":1,"text":"int  21","bytes":"CD21","data":"444f532024bb0a0033c933d2f7f3524185c075f65a80c230b402cd21e2f6c3d40a053030508ad4b402cd215ab402cd21c3","stack":"0000","out":"","acc":[]},{"r":[5,65280,0,2070,256,65534,2332,65534,2070,2070,2070,2070,261,29186],"line":2,"text":"push a