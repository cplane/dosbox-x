{"v":1,"src":"MOV     AH, 03h          ; read the cursor: CX = its shape\nMOV     BH, 0\nINT     10h\nMOV     [SHAPE1], CX     ; keep it\nMOV     AH, 01h          ; set the shape\nMOV     CX, 0007h        ; scan lines 0 to 7: a full block\nINT     10h\nMOV     AH, 09h\nMOV     DX, OFFSET MSG1  ; the block blinks at the end of this text\nINT     21h\nMOV     CX, 001Eh        ; wait 2 s: CX:DX = 1E8480h microseconds\nMOV     DX, 8480h\nMOV     AH, 86h          ; BIOS: wait\nINT     15h\nMOV     AH, 01h          ; the old shape back\nMOV     CX, [SHAPE1]\nINT     10h\nMOV     AH, 09h\nMOV     DX, OFFSET MSG2\nINT     21h\nMOV     AX, [SHAPE1]\nCALL    PHEX4            ; the shape we found\nMOV     AH, 09h\nMOV     DX, OFFSET MSG3\nINT     21h\n\nSHAPE1  DW      0\nMSG1    DB      \"Block cursor for 2 seconds: $\"\nMSG2    DB      \"back, it was $\"\nMSG3    DB      \"h\", 13, 10, \"$\"\nPHEX4:                   ; print AX as four hex digits\nPUSH    AX\nMOV     AL, AH\nCALL    PHEX2            ; the high byte first\nPOP     AX\nPHEX2:                   ; print AL as two hex digits; changes AX, CX, DX\nPUSH    AX\nMOV     CL, 4\nSHR     AL, CL           ; the high nibble first\nCALL    PDIG1\nPOP     AX\nAND     AL, 0Fh          ; then the low one, falling into PDIG1\nPDIG1:\nADD     AL, \"0\"\nCMP     AL, \"9\"\nJBE     PDIG2\nADD     AL, 7            ; \"A\"..\"F\"\nPDIG2:\nMOV     DL, AL\nMOV     AH, 02h          ; DOS: print DL\nINT     21h\nRET","seg":2070,"dataAt":323,"vars":[{"name":"SHAPE1","offset":323,"unit":2,"length":2},{"name":"MSG1","offset":325,"unit":1,"length":29},{"name":"MSG2","offset":354,"unit":1,"length":14},{"name":"MSG3","offset":368,"unit":1,"length":37}],"states":[{"r":[0,0,255,2070,256,65534,2332,65534,2070,2070,2070,2070,256,29186],"line":0,"text":"mov  ah,03","bytes":"B403","data":"0000426c6f636b20637572736f7220666f722032207365636f6e64733a20246261636b2c206974207761732024680d0a24508ac4e801005850b104d2e8e8030058240f04303c39760204078ad0b402cd21