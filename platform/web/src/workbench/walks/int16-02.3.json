{"v":3,"src":"MOV     AH, 02h          ; BIOS: get the shift flags\nINT     16h              ; AL = the flag byte\nMOV     BL, AL           ; keep it: printing changes AL\nMOV     DX, OFFSET FREE1\nTEST    BL, 0Fh          ; bits 0-3: Shift, Ctrl, Alt held?\nJZ      SHOW1\nMOV     DX, OFFSET HELD1\nSHOW1:\nMOV     AH, 09h\nINT     21h\nMOV     AX, 40h\nMOV     ES, AX           ; ES = the BIOS data area\nXOR     BYTE PTR ES:[17h], 80h ; flip the Insert flag by hand\nMOV     AH, 02h\nINT     16h              ; AL = the flags as they are now\nXOR     BYTE PTR ES:[17h], 80h ; and flip it back\nXOR     AL, BL           ; 1 bits: what changed\nMOV     BL, AL\nMOV     DX, OFFSET DIFF1\nMOV     AH, 09h          ; DOS: print the $-string at DS:DX\nINT     21h\nMOV     AL, BL\nCALL    PHEX2            ; 80: only bit 7\n\nFREE1   DB      \"no Shift, Ctrl or Alt held\", 13, 10, \"$\"\nHELD1   DB      \"a Shift, Ctrl or Alt key is down\", 13, 10, \"$\"\nDIFF1   DB      \"changed bits: $\"\nPHEX2   PROC    NEAR     ; print AL as two hex digits; keeps every register\nPUSH    AX\nPUSH    CX\nPUSH    DX\nMOV     DH, AL           ; keep the byte\nMOV     CL, 4\nSHR     AL, CL           ; the high nibble\nCALL    HEXN1\nMOV     AL, DH\nAND     AL, 0Fh          ; the low nibble\nCALL    HEXN1\nPOP     DX\nPOP     CX\nPOP     AX\nRET\nHEXN1:\nADD     AL, \"0\"\nCMP     AL, \"9\"\nJBE     HEXN2\nADD     AL, 7            ; past \"9\": \"A\"..\"F\"\nHEXN2:\nMOV     DL, AL\nMOV     AH, 02h\nINT     21h\nRET\nPHEX2   ENDP","seg":2070,"dataAt":319,"vars":[{"name":"FREE1","offset":319,"unit":1,"length":29},{"name":"HELD1","offset":348,"unit":1,"length":35},{"name":"DIFF1","offset":383,"unit":1,"length":53}],"image":"","states":[{"r":[0,0,255,2070,256,65534,2332,65534,2070,2070,2070,2070,256,29186],"line":0,"text":"mov  ah,02","bytes":"B402","data":"6e6f2053686966742c204374726c206f7220416c742068656c640d0a24612053686966742c204374726c206f7220416c74206b657920697320646f776e0d0a246368616e67656420626