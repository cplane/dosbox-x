{"v":1,"src":"MOV     SI, OFFSET KEYS1\nCALL    STUFF1           ; \"o\" and \"k\" wait in the BIOS buffer\nNEXT1:\nMOV     DL, 0FFh         ; DL = FFh: read, if a key is there\nMOV     AH, 06h          ; DOS: direct console I/O\nINT     21h\nJZ      DONE1            ; ZF = 1: nothing waiting, and no waiting for it\nAND     AL, 0DFh         ; lower case to upper case\nMOV     DL, AL           ; DL <> FFh: print it\nMOV     AH, 06h\nINT     21h\nJMP     NEXT1\nDONE1:\n\nKEYS1   DW      186Fh, 256Bh, 0  ; \"o\", \"k\": scan code and ASCII\nSTUFF1  PROC    NEAR     ; \"type\" the keys at DS:SI: words, 0 ends the list\nCLD\nST1:\nLODSW                    ; AH = scan code, AL = ASCII\nTEST    AX, AX\nJZ      ST2\nMOV     CX, AX           ; CH = scan code, CL = ASCII\nMOV     AH, 05h          ; BIOS: store a keystroke in the keyboard buffer\nINT     16h\nJMP     ST1\nST2:\nRET\nSTUFF1  ENDP","seg":2070,"dataAt":285,"vars":[{"name":"KEYS1","offset":285,"unit":2,"length":21}],"states":[{"r":[0,0,255,2070,256,65534,2332,65534,2070,2070,2070,2070,256,29186],"line":0,"text":"mov  si,011D","bytes":"BE1D01","data":"6f186b250000fcad85c074088bc8b405cd16ebf3c3","stack":"0000","out":"","acc":[]},{"r":[0,0,255,2070,285,65534,2332,65534,2070,2070,2070,2070,259,29186],"line":1,"text":"call 00000123 ($+1d)","bytes":"E81D00","data":"6f186b250000fcad85c074088bc8b405cd16ebf3c3","stack":"0000","out":"","acc":[]},{"r":[0,0,255,2070,285,65534,2332,65532,2070,2070,2070,2070,291,29186],"line":16,"text":"cld","bytes":"FC","data":"6f186b250000fcad85c074088bc8b405cd16ebf3c3","stack":"06010000","out":"","acc":[[98652,2,1]]},{"r":[0,0,255,2070,285,65534,2332,65532,2070,2070,2070,2070,292,29186],"line":18,"text":"lodsw","bytes":"AD","data":"6f186b250000fcad85c074088bc8b405cd16ebf3c3","stack":"06010000","out":"","acc":[]},{"r":[6255,0,255,2070,287,65534,2332,65532,2070,2070,2070,2070,293,29186],"line":19,"text":"test ax,ax","bytes":"85C0","data":"6f186b250000fcad85c074088bc8b405cd16ebf3c3","stack":"06