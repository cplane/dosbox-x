{"v":3,"src":"MOV     AH, 3Ch          ; DOS: create TEST.TXT\nXOR     CX, CX           ; CX = 0: normal attributes\nMOV     DX, OFFSET FNAME\nINT     21h\nCALL    CHECK            ; stop if CF = 1\nMOV     BX, AX           ; BX = the handle\nMOV     AH, 3Eh          ; close it first\nINT     21h\nMOV     DX, OFFSET M1\nMOV     AH, 09h          ; DOS: print the string at DS:DX\nINT     21h\nMOV     AH, 41h          ; DOS: delete TEST.TXT\nMOV     DX, OFFSET FNAME\nINT     21h\nCALL    REPORT\nMOV     DX, OFFSET M2\nMOV     AH, 09h          ; DOS: print the string at DS:DX\nINT     21h\nMOV     AH, 41h          ; the same name again\nMOV     DX, OFFSET FNAME\nINT     21h\nMOV     DX, OFFSET GONE1 ; CF = 1: nothing by that name\nJC      SHOW1\nMOV     DX, OFFSET ODD1\nSHOW1:\nMOV     AH, 09h\nINT     21h\n\nFNAME   DB      \"TEST.TXT\", 0\nM1      DB      \"first delete: $\"\nM2      DB      \"second delete: $\"\nGONE1   DB      \"CF = 1, there is nothing left to delete\", 13, 10, \"$\"\nODD1    DB      \"CF = 0?\", 13, 10, \"$\"\nCRLF    DB      13, 10, \"$\"\nCHECK   PROC    NEAR     ; CF = 1: print the error code in AL and exit\nJNC     CHECK1\nPUSH    AX\nMOV     DX, OFFSET FAILMSG\nMOV     AH, 09h\nINT     21h\nPOP     AX\nCALL    PHEXB\nMOV     AX, 4C01h        ; exit with code 1\nINT     21h\nCHECK1:\nRET\nCHECK   ENDP\nFAILMSG DB      \"failed: error $\"\nREPORT  PROC    NEAR     ; CF = 0: \"ok\"; CF = 1: \"error\" and AL\nJC      REPORT1\nMOV     DX, OFFSET OKMSG\nMOV     AH, 09h\nINT     21h\nRET\nREPORT1:\nPUSH    AX\nMOV     DX, OFFSET ERRMSG\nMOV     AH, 09h\nINT     21h\nPOP     AX\nCALL    PHEXB            ; the error code\nMOV     DX, OFFSET CRLF\nMOV     AH, 09h\nINT     21h\nRET\nREPORT  ENDP\nOKMSG   DB      \"ok\", 13, 10, \"$\"\nERRMSG  DB      \"error $\"\nPHEXB   PROC    NEAR     ; print AL as two hex digits\nPUSH    CX\nPUSH    DX\nMOV     DH, AL           ; keep the byte\nMOV     CL, 4\nSHR     AL, CL           ; the high digit first\nMOV     CX, 2\nPHEXB1:\nAND     AL, 0Fh\nADD     AL, \"0\"\nCMP     AL, \"9\"\nJBE     PHEXB2\nADD     AL, 7            ; 10..15 -> \"A\"..\"F\"\nPHEXB2:\nMOV     DL, AL\nMOV     AH, 02h          ; DOS: print DL\nINT     21h\nMOV     AL, DH           ; then the low digit\nLOOP    PHEXB1\nPOP     DX\nPOP     CX\nRET\nPHEXB   ENDP","seg":2070,"dataAt":322,"vars":[{"name":"FNAME","offset":322,"unit":1,"length":9},{"name":"M1","offset":331,"unit":1,"length":15},{"name":"M2","offset":346,"unit":1,"length":16},{"name":"GONE1","offset":362,"unit":1,"length":42},{"name":"ODD1","offset":404,"unit":1,"length":10},{"name":"CRLF","offset":414,"unit":1,"length":23},{"name":"FAILMSG","offset":437,"unit":1,"length":45},{"name":"OKMSG","offset":482,"unit":1,"length":5},{"name":"ERRMSG","offset":487,"unit":1,"length":41}],"image":"","states":[{"r":[0,0,255,2070,256,65534,2332,65534,2070,2070,2070,2070,256,29186],"line":0,"text":"mov  ah,3C","bytes":"B43C","data":"","stack":"0000","out":"","acc":[]},{"r":[15360,0,255,2070,256,65534,2332,65534,2070,2070,2070,2070,258,29186],"line":1,"text":"xor  cx,cx","bytes":"33C9","data":"","stack":"0000","out":"","acc":[]},{"r":[15360,0,0,2070,256,65534,2332,65534,2070,2070,2070,2070,260,29254],"line":2,"text":"mov  dx,0142","bytes":"BA4201","data":"","stack":"0000","out":"","acc":[]},{"r":[15360,0,0,322,256,65534,2332,65534,2070,2070,2070,2070,263,29254],"line":3,"text":"int  21","bytes":"CD21","data":"","stack":"0000","out":"","acc":[]},{"r":[5,0,0,322,256,65534,2332,65534,2070,2070,2070,2070,265,29254],"line":4,"text":"call 000001A1 ($+95)","bytes":"E89500","data":"","stack":"0000","out":"","acc":[[33442,1,0],[33443,1,0],[33444,1,0],[33445,1,0],[33446,1,0],[33447,1,0],[33448,1,0],[33449,1,0],[33450,1,0]],"rows":[[2090,"cd21544553542e545854006669727374"]]},{"r":[5,0,0,322,256,65534,2332,65532,2070,2070,2070,2070,417,29254],"line":35,"text":"jnc  000001B4 ($+11)","bytes":"7311","data":"","stack":"0c010000","out":"","acc":[[98652,2,1]],"rows":[[6165,"feff