{"v":1,"src":"MOV     SI, OFFSET KEYS1\nCALL    STUFF1           ; \"hello\" and Enter wait in the BIOS buffer\nMOV     DX, OFFSET BUF1\nMOV     AH, 0Ah          ; DOS: read a line into the buffer at DS:DX\nINT     21h              ; echoes \"hello\", then a CR only\nMOV     DX, OFFSET CRLF1\nMOV     AH, 09h          ; DOS: print the string at DS:DX\nINT     21h\nMOV     BL, BUF1[1]      ; the count: 5\nXOR     BH, BH\nMOV     BYTE PTR BUF1[BX+2], \"$\" ; over the 0Dh, for 09h\nMOV     DL, BL\nADD     DL, \"0\"\nMOV     AH, 02h          ; DOS: print the character in DL\nINT     21h\nMOV     DL, \" \"\nMOV     AH, 02h          ; DOS: print the character in DL\nINT     21h\nMOV     DX, OFFSET BUF1+2\nMOV     AH, 09h          ; DOS: print the string at DS:DX\nINT     21h\n\nKEYS1   DW      2368h, 1265h, 266Ch, 266Ch, 186Fh, 1C0Dh, 0  ; h e l l o Enter\nBUF1    DB      20, 0, 20 DUP(0)  ; room for 19 characters and the CR\nCRLF1   DB      13, 10, \"$\"\nSTUFF1  PROC    NEAR     ; \"type\" the keys at DS:SI: words, 0 ends the list\nCLD\nST1:\nLODSW                    ; AH = scan code, AL = ASCII\nTEST    AX, AX\nJZ      ST2\nMOV     CX, AX           ; CH = scan code, CL = ASCII\nMOV     AH, 05h          ; BIOS: store a keystroke in the keyboard buffer\nINT     16h\nJMP     ST1\nST2:\nRET\nSTUFF1  ENDP","seg":2103,"dataAt":314,"vars":[{"name":"KEYS1","offset":314,"unit":2,"length":14},{"name":"BUF1","offset":328,"unit":1,"length":22},{"name":"CRLF1","offset":350,"unit":1,"length":18}],"states":[{"r":[0,0,255,2103,256,65534,2332,65534,2103,2103,2103,2103,256,29186],"line":0,"text":"mov  si,013A","bytes":"BE3A01","data":"682365126c266c266f180d1c0000140000000000000000000000000000000000000000000d0a24fcad85c074088bc8b405cd16ebf3c3","stack":"0000","out":"","acc":[]},{"r":[0,0,255,2103,314,65534,2332,65534,2103,2103,2103,2103,259,29186],"line":1,"text":"call 00000161 ($+5b)","bytes":"E85B00","data":"682365126c266c266f180d1c0000140000000000000000000000000000000000000000000d0a24fc