{"v":1,"src":"MOV     AH, 2Ah          ; DOS: get the date\nINT     21h\nPUSH    DX               ; today, for later\nPUSH    CX\nMOV     DX, 021Eh        ; DH = 2, DL = 30: 30 February\nMOV     AH, 2Bh          ; DOS: set the date\nINT     21h              ; AL = FFh: refused, nothing changed\nCALL    HEX2\nMOV     DL, \" \"\nMOV     AH, 02h          ; DOS: print the character in DL\nINT     21h\nPOP     CX               ; today again\nPOP     DX\nMOV     AH, 2Bh\nINT     21h              ; the date it already was: AL = 00h\nCALL    HEX2\n\nHEX2    PROC    NEAR     ; print AL as two hex digits\nPUSH    AX\nMOV     CL, 4\nSHR     AL, CL           ; the high digit first\nCALL    NIB1\nPOP     AX\nAND     AL, 0Fh          ; then the low one\nCALL    NIB1\nRET\nHEX2    ENDP\nNIB1    PROC    NEAR     ; print AL (0-15) as one hex digit\nADD     AL, \"0\"\nCMP     AL, \"9\"\nJBE     NIB2\nADD     AL, 7            ; 10-15 become \"A\"-\"F\"\nNIB2:\nMOV     DL, AL\nMOV     AH, 02h\nINT     21h\nRET\nNIB1    ENDP","seg":2070,"dataAt":322,"vars":[],"states":[{"r":[0,0,255,2070,256,65534,2332,65534,2070,2070,2070,2070,256,29186],"line":0,"text":"mov  ah,2A","bytes":"B42A","data":"","stack":"0000","out":"","acc":[]},{"r":[10752,0,255,2070,256,65534,2332,65534,2070,2070,2070,2070,258,29186],"line":1,"text":"int  21","bytes":"CD21","data":"","stack":"0000","out":"","acc":[]},{"r":[10758,0,2026,2584,256,65534,2332,65534,2070,2070,2070,2070,260,29186],"line":2,"text":"push dx","bytes":"52","data":"","stack":"0000","out":"","acc":[]},{"r":[10758,0,2026,2584,256,65534,2332,65532,2070,2070,2070,2070,261,29186],"line":3,"text":"push cx","bytes":"51","data":"","stack":"180a0000","out":"","acc":[[98652,2,1]]},{"r":[10758,0,2026,2584,256,65534,2332,65530,2070,2070,2070,2070,262,29186],"line":4,"text":"mov  dx,021E","bytes":"BA1E02","data":"","stack":"ea07180a0000","out":"","acc":[[98650,2,1]]},{"r":[10758,0,2026,542,256,65534,2332,65530,2070,2070,2070,2070,265,29186],"line":5,"text":"mov 