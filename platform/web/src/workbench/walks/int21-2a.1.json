{"v":1,"src":"MOV     AH, 2Ah          ; DOS: get the date\nINT     21h              ; CX = year, DH = month, DL = day, AL = weekday\nPUSH    AX               ; keep the weekday\nPUSH    DX               ; and the month and day\nMOV     AX, CX\nCALL    PDEC1            ; the year\nMOV     DL, \"-\"\nMOV     AH, 02h          ; DOS: print the character in DL\nINT     21h\nPOP     DX\nPUSH    DX\nMOV     AL, DH\nCALL    P2D1             ; the month\nMOV     DL, \"-\"\nMOV     AH, 02h          ; DOS: print the character in DL\nINT     21h\nPOP     DX\nMOV     AL, DL\nCALL    P2D1             ; the day\nMOV     DL, \" \"\nMOV     AH, 02h          ; DOS: print the character in DL\nINT     21h\nPOP     AX               ; AL = the weekday, 0 = Sunday\nMOV     AH, 3\nMUL     AH               ; AX = weekday * 3: its name in the table\nADD     AX, OFFSET DAYS1\nMOV     DX, AX\nMOV     CX, 3            ; three letters\nMOV     BX, 1            ; to standard output\nMOV     AH, 40h          ; DOS: write to a handle\nINT     21h\n\nDAYS1   DB      \"SunMonTueWedThuFriSat\"\nPDEC1   PROC    NEAR     ; print AX in decimal\nMOV     BX, 10\nXOR     CX, CX           ; digits so far\nPD1:\nXOR     DX, DX\nDIV     BX               ; AX = AX / 10, DX = the last digit\nPUSH    DX\nINC     CX\nTEST    AX, AX\nJNZ     PD1\nPD2:\nPOP     DX               ; the digits come back first to last\nADD     DL, \"0\"\nMOV     AH, 02h\nINT     21h\nLOOP    PD2\nRET\nPDEC1   ENDP\nP2D1    PROC    NEAR     ; print AL (0-99) as two digits\nAAM                      ; AH = AL / 10, AL = AL mod 10\nADD     AX, 3030h        ; both digits to characters\nPUSH    AX\nMOV     DL, AH           ; the tens\nMOV     AH, 02h\nINT     21h\nPOP     DX               ; DL = the units\nMOV     AH, 02h\nINT     21h\nRET\nP2D1    ENDP","seg":2070,"dataAt":323,"vars":[{"name":"DAYS1","offset":323,"unit":1,"length":65}],"states":[{"r":[0,0,255,2070,256,65534,2332,65534,2070,2070,2070,2070,256,29186],"line":0,"text":"mov  ah,