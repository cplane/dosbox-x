{"v":3,"src":"MOV     AH, 00h          ; BIOS: read the tick count\nINT     1Ah              ; CX:DX = ticks since midnight\nMOV     BX, DX           ; the low word is enough for short times\nWAIT1:\nMOV     AH, 00h\nINT     1Ah\nMOV     AX, DX\nSUB     AX, BX           ; ticks gone by (wraps correctly)\nCMP     AX, 18           ; 18 ticks: about one second\nJB      WAIT1\nCALL    PDEC             ; 18\nMOV     DX, OFFSET SEC1\nMOV     AH, 09h          ; DOS: print the $-string at DS:DX\nINT     21h\n\nSEC1    DB      \" ticks, about one second\", 13, 10, \"$\"\nPDEC    PROC    NEAR     ; print AX in decimal; keeps every register\nPUSH    AX\nPUSH    BX\nPUSH    CX\nPUSH    DX\nMOV     BX, 10\nXOR     CX, CX           ; digits on the stack\nDECD1:\nXOR     DX, DX\nDIV     BX               ; AX = AX / 10, DX = the last digit\nPUSH    DX\nINC     CX\nTEST    AX, AX\nJNZ     DECD1\nDECD2:\nPOP     DX               ; the digits come back first to last\nADD     DL, \"0\"\nMOV     AH, 02h\nINT     21h\nLOOP    DECD2\nPOP     DX\nPOP     CX\nPOP     BX\nPOP     AX\nRET\nPDEC    ENDP","seg":2070,"dataAt":290,"vars":[{"name":"SEC1","offset":290,"unit":1,"length":61}],"image":"","states":[{"r":[0,0,255,2070,256,65534,2332,65534,2070,2070,2070,2070,256,29186],"line":0,"text":"mov  ah,00","bytes":"B400","data":"207469636b732c2061626f7574206f6e65207365636f6e640d0a2450535152bb0a0033c933d2f7f3524185c075f65a80c230b402cd21e2f65a595b58c3","stack":"0000","out":"","acc":[]},{"r":[0,0,255,2070,256,65534,2332,65534,2070,2070,2070,2070,258,29186],"line":1,"text":"int  1A","bytes":"CD1A","data":"207469636b732c2061626f7574206f6e65207365636f6e640d0a2450535152bb0a0033c933d2f7f3524185c075f65a80c230b402cd21e2f65a595b58c3","stack":"0000","out":"","acc":[]},{"r":[0,0,17,63573,256,65534,2332,65534,2070,2070,2070,2070,260,29186],"line":2,"text":"mov  bx,dx","bytes":"8BDA","data":"207469636b732c2061626f7574206f6e65207365636f6e640d0a2450535152bb0a0033c933d2f7f3524185c075f65a80c230b402cd21e2f65a595b58